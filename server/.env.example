# -------------------------------------------------------------
# SERVER ENVIRONMENT CONFIGURATION
# -------------------------------------------------------------
# Copy this file to .env and fill in your values.
# IMPORTANT: Never commit your real .env file to version control.

# MongoDB Connection URI
# For local MongoDB: mongodb://127.0.0.1:27017/mcq-db
# For MongoDB Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/mcq-db
MONGO_URI=mongodb://127.0.0.1:27017/mcq-db

# Server Port
PORT=5000
